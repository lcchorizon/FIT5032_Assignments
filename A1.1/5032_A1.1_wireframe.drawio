        <mxCell id="pYWKltPqwYzBJNLA8t4d-55" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div&gt;&lt;div&gt;Login&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Email&lt;/div&gt;&lt;div&gt;[______________________]&lt;/div&gt;&lt;div&gt;Please enter a valid email address.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Password&lt;/div&gt;&lt;div&gt;[______________________]&lt;/div&gt;&lt;div&gt;Password is required.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;[ ] Remember me&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;[&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Login&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;]&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Forgot password?&lt;/div&gt;&lt;div&gt;Don&#39;t have an account? Register&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;Successful login → My Activities&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(102, 102, 102);&quot;&gt;Forgot password → Password Reset&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
