{
  "name": "greenconnect-a3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "node --test tests/*.test.js",
    "test:emulators": "firebase emulators:exec --only auth,firestore,functions --project demo-greenconnect-a3 \"node --test --test-concurrency=1 tests/integration/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-greenconnect-a3 --import=./emulator-data --export-on-exit=./emulator-data",
    "seed:emulators": "node scripts/seed-emulators.js",
    "deploy": "firebase deploy --only hosting:greenconnect,functions:greenconnect,firestore:rules"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "bootstrap": "^5.3.8",
    "primevue": "^4.0.0",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4",
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-eslint-parser": "^10.4.1",
    "firebase-tools": "^15.33.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
